{# Field names carry no `settings[…]` prefix: `craft\base\Plugin::settingsResponse()` runs this
   template's output through `View::namespaceInputs(…, 'settings')`, so a name written as
   `settings[foo]` here posts as `settings[settings][foo]` and saves nothing at all — the screen
   looks right, Craft says "Plugin settings saved", and every edit is silently discarded. #}
{% import '_includes/forms' as forms %}

{% set commerceReady = craft.app.plugins.isPluginEnabled('commerce') %}

{% if not commerceReady %}
    <div class="pane">
        <p class="error">{{ 'Craft Commerce is not installed or enabled. Erpy needs it to do anything.'|t('erpy') }}</p>
    </div>
{% endif %}

<div class="pane" style="border-left: 3px solid #cdd8e4;">
    <p>
        {{ 'Credentials live on each connection, not here. This screen is for the things that should be true of every ERP you talk to.'|t('erpy') }}
        <a href="{{ url('erpy/connections') }}">{{ 'Go to connections'|t('erpy') }}</a>
    </p>
</div>

<h2>{{ 'Orders'|t('erpy') }}</h2>

{{ forms.lightswitchField({
    label: 'Send orders to the ERP automatically'|t('erpy'),
    instructions: 'Queues a push when Commerce marks an order complete. The push always goes through the queue, so a slow or offline ERP can never delay or fail a checkout.'|t('erpy'),
    id: 'pushOrdersOnComplete',
    name: 'pushOrdersOnComplete',
    on: settings.pushOrdersOnComplete
}) }}

{{ forms.textField({
    label: 'Wait before sending'|t('erpy'),
    instructions: 'Seconds to hold an order back. Worth setting when payment capture is asynchronous and the ERP should not see an order the gateway has not settled.'|t('erpy'),
    id: 'pushOrderDelaySeconds',
    name: 'pushOrderDelaySeconds',
    type: 'number',
    size: 6,
    value: settings.pushOrderDelaySeconds,
    errors: settings.getErrors('pushOrderDelaySeconds')
}) }}

{{ forms.textField({
    label: 'Delivery attempts'|t('erpy'),
    instructions: 'How many times the queue retries an order before it lands on the Problems screen for good.'|t('erpy'),
    id: 'pushMaxAttempts',
    name: 'pushMaxAttempts',
    type: 'number',
    size: 4,
    value: settings.pushMaxAttempts,
    errors: settings.getErrors('pushMaxAttempts')
}) }}

<hr>

<h2>{{ 'Storefront'|t('erpy') }}</h2>

{{ forms.lightswitchField({
    label: 'Apply ERP contract pricing'|t('erpy'),
    instructions: 'Overrides cart line prices with the customer’s negotiated price, price list or quantity break. The most specific audience wins — a price agreed with this customer beats their group’s, even when it is higher.'|t('erpy'),
    id: 'applyContractPricing',
    name: 'applyContractPricing',
    on: settings.applyContractPricing
}) }}

{{ forms.lightswitchField({
    label: 'Enforce credit limits'|t('erpy'),
    instructions: 'Off by default, because switching it on can stop a sale. When on, `craft.erpy.canSpend()` answers false for accounts over their limit or on stop — your templates decide what to do about it.'|t('erpy'),
    id: 'enforceCreditLimit',
    name: 'enforceCreditLimit',
    on: settings.enforceCreditLimit
}) }}

{{ forms.textField({
    label: 'Trust credit figures for'|t('erpy'),
    instructions: 'Minutes. Older figures are re-fetched before they are allowed to block anything.'|t('erpy'),
    id: 'creditMaxAgeMinutes',
    name: 'creditMaxAgeMinutes',
    type: 'number',
    size: 6,
    value: settings.creditMaxAgeMinutes
}) }}

<hr>

<h2>{{ 'Scheduling'|t('erpy') }}</h2>

{{ forms.lightswitchField({
    label: 'Run scheduled syncs'|t('erpy'),
    instructions: 'Each connection sets its own interval per entity. For a large catalogue, run `php craft erpy/sync/due` from cron instead — it has no request timeout.'|t('erpy'),
    id: 'scheduleEnabled',
    name: 'scheduleEnabled',
    on: settings.scheduleEnabled
}) }}

<hr>

<h2>{{ 'Alerts'|t('erpy') }}</h2>

<p class="light">{{ 'One message when a connection gets into trouble, one when it is fine again — never one per failure. Alerts are checked after every run and by `php craft erpy/sync/due`; a stalled schedule can only be noticed by the second, so put that (or `erpy/alerts/check`) on cron.'|t('erpy') }}</p>

{{ forms.autosuggestField({
    label: 'Email alerts to'|t('erpy'),
    instructions: 'Addresses separated by commas, or an environment variable. Leave empty for no email.'|t('erpy'),
    id: 'alertRecipients',
    name: 'alertRecipients',
    suggestEnvVars: true,
    value: settings.alertRecipients,
    errors: settings.getErrors('alertRecipients')
}) }}

{{ forms.autosuggestField({
    label: 'Slack or Teams webhook URL'|t('erpy'),
    instructions: 'Optional. An incoming-webhook URL — best kept in an environment variable, because the URL is the credential. Only public hosts are allowed and redirects are never followed.'|t('erpy'),
    id: 'alertWebhookUrl',
    name: 'alertWebhookUrl',
    suggestEnvVars: true,
    value: settings.alertWebhookUrl,
    errors: settings.getErrors('alertWebhookUrl')
}) }}

{{ forms.selectField({
    label: 'Webhook format'|t('erpy'),
    id: 'alertWebhookFormat',
    name: 'alertWebhookFormat',
    options: [
        { value: 'slack', label: 'Slack'|t('erpy') },
        { value: 'teams', label: 'Microsoft Teams'|t('erpy') },
        { value: 'json', label: 'Plain JSON (your own receiver)'|t('erpy') },
    ],
    value: settings.alertWebhookFormat,
    errors: settings.getErrors('alertWebhookFormat')
}) }}

{{ forms.autosuggestField({
    label: 'Webhook signing secret'|t('erpy'),
    instructions: 'Optional. When set, each webhook carries `X-Erpy-Timestamp` and `X-Erpy-Signature: sha256=…`, an HMAC of `timestamp.body`, so your own receiver can verify it. Slack and Teams ignore it.'|t('erpy'),
    id: 'alertWebhookSecret',
    name: 'alertWebhookSecret',
    suggestEnvVars: true,
    value: settings.alertWebhookSecret
}) }}

{{ forms.lightswitchField({
    label: 'Alert when documents keep failing'|t('erpy'),
    id: 'alertOnDeadLetters',
    name: 'alertOnDeadLetters',
    on: settings.alertOnDeadLetters,
    toggle: 'alert-deadletters'
}) }}

<div id="alert-deadletters" class="{{ settings.alertOnDeadLetters ? '' : 'hidden' }}">
    {{ forms.textField({
        label: 'Failures that open an alert'|t('erpy'),
        instructions: 'This many documents landing on the Problems screen inside the window below. It closes again after a whole window with none.'|t('erpy'),
        id: 'alertDeadLetterThreshold',
        name: 'alertDeadLetterThreshold',
        type: 'number',
        size: 5,
        value: settings.alertDeadLetterThreshold,
        errors: settings.getErrors('alertDeadLetterThreshold')
    }) }}

    {{ forms.textField({
        label: 'Window'|t('erpy'),
        instructions: 'Minutes.'|t('erpy'),
        id: 'alertDeadLetterWindowMinutes',
        name: 'alertDeadLetterWindowMinutes',
        type: 'number',
        size: 5,
        value: settings.alertDeadLetterWindowMinutes,
        errors: settings.getErrors('alertDeadLetterWindowMinutes')
    }) }}
</div>

{{ forms.lightswitchField({
    label: 'Alert when the ERP refuses the credentials'|t('erpy'),
    instructions: 'A 401 after Erpy has already tried to re-authenticate, or an OAuth refresh the ERP will not honour. Nothing syncs until somebody fixes it.'|t('erpy'),
    id: 'alertOnAuthFailure',
    name: 'alertOnAuthFailure',
    on: settings.alertOnAuthFailure
}) }}

{{ forms.textField({
    label: 'Alert when a scheduled sync stalls after'|t('erpy'),
    instructions: 'Hours without a successful run of an entity that has an interval — or twice its interval, if that is longer. Zero switches it off.'|t('erpy'),
    id: 'alertStallHours',
    name: 'alertStallHours',
    type: 'number',
    size: 5,
    value: settings.alertStallHours,
    errors: settings.getErrors('alertStallHours')
}) }}

{{ forms.textField({
    label: 'Quiet period after a recovery'|t('erpy'),
    instructions: 'Minutes. An incident that comes straight back is reported when this ends, if it is still happening — so a flapping connection cannot fill an inbox.'|t('erpy'),
    id: 'alertCooldownMinutes',
    name: 'alertCooldownMinutes',
    type: 'number',
    size: 5,
    value: settings.alertCooldownMinutes,
    errors: settings.getErrors('alertCooldownMinutes')
}) }}

<div class="field">
    <button type="button" class="btn" id="erpy-test-alert">{{ 'Send a test alert'|t('erpy') }}</button>
    <p class="light">{{ 'Uses the saved settings — save first.'|t('erpy') }}</p>
</div>

{% js %}
    document.getElementById('erpy-test-alert')?.addEventListener('click', (e) => {
        const button = e.currentTarget;
        button.classList.add('loading');
        Craft.sendActionRequest('POST', 'erpy/alerts/test')
            .then((response) => Craft.cp.displaySuccess(response.data.message))
            .catch(({response}) => Craft.cp.displayError(response?.data?.message || Craft.t('erpy', 'The test could not be sent.')))
            .finally(() => button.classList.remove('loading'));
    });
{% endjs %}

<hr>

<h2>{{ 'Logging'|t('erpy') }}</h2>

{{ forms.lightswitchField({
    label: 'Log requests'|t('erpy'),
    instructions: 'Credentials are redacted before anything is written, at the transport rather than here — there is no path that could miss it.'|t('erpy'),
    id: 'logRequests',
    name: 'logRequests',
    on: settings.logRequests,
    toggle: 'log-detail'
}) }}

<div id="log-detail" class="{{ settings.logRequests ? '' : 'hidden' }}">
    {{ forms.lightswitchField({
        label: 'Include request and response bodies'|t('erpy'),
        instructions: 'The useful part, and the large part.'|t('erpy'),
        id: 'logBodies',
        name: 'logBodies',
        on: settings.logBodies
    }) }}

    {{ forms.lightswitchField({
        label: 'Only log failures'|t('erpy'),
        instructions: 'Worth switching on once you are live: a nightly catalogue sync is tens of thousands of successful requests nobody will ever read.'|t('erpy'),
        id: 'logErrorsOnly',
        name: 'logErrorsOnly',
        on: settings.logErrorsOnly
    }) }}

    {{ forms.textField({
        label: 'Keep log entries for'|t('erpy'),
        instructions: 'Days. Zero keeps them forever.'|t('erpy'),
        id: 'logRetentionDays',
        name: 'logRetentionDays',
        type: 'number',
        size: 5,
        value: settings.logRetentionDays
    }) }}
</div>

{{ forms.textField({
    label: 'Keep sync history for'|t('erpy'),
    instructions: 'Days.'|t('erpy'),
    id: 'runRetentionDays',
    name: 'runRetentionDays',
    type: 'number',
    size: 5,
    value: settings.runRetentionDays
}) }}

{{ forms.lightswitchField({
    label: 'Record unchanged records'|t('erpy'),
    instructions: 'Off by default. On a 40,000-SKU delta sync, "unchanged" is 39,900 of the rows, and storing them all costs more than the catalogue.'|t('erpy'),
    id: 'recordSkippedItems',
    name: 'recordSkippedItems',
    on: settings.recordSkippedItems
}) }}

{{ forms.textField({
    label: 'Give up on a stuck sync after'|t('erpy'),
    instructions: 'Minutes. A run still marked “running” after this long had its queue worker killed, and is closed out so it stops blocking the next one.'|t('erpy'),
    id: 'staleRunMinutes',
    name: 'staleRunMinutes',
    type: 'number',
    size: 5,
    value: settings.staleRunMinutes
}) }}
