{
    "name": "justinholtweb/craft-erpy",
    "description": "The ERP gateway for Craft Commerce — one sync engine, one mapping UI, one log, and a free add-on for every major ERP.",
    "version": "5.1.0",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "craft-commerce",
        "commerce",
        "erp",
        "integration",
        "sync",
        "b2b",
        "middleware"
    ],
    "license": "proprietary",
    "homepage": "https://justinholt.com/plugins/craft-erpy",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "docs": "https://justinholt.com/plugins/craft-erpy/docs",
        "source": "https://github.com/justinholtweb/craft-erpy",
        "issues": "https://github.com/justinholtweb/craft-erpy/issues"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "craftcms/cms": "^5.3.0",
        "craftcms/commerce": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\erpy\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Erpy",
        "handle": "erpy",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-erpy/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-erpy/main/CHANGELOG.md",
        "class": "justinholtweb\\erpy\\Plugin"
    }
}
